# ==========================================================
# NARRA — Local AI Narrator Avatar Studio
# Model weights and runtime-generated media are never committed.
# ==========================================================

# --- Model files --------------------------------------------------
models/**
!models/**/.gitkeep
*.safetensors
*.ckpt
*.pt
*.pth
*.bin
*.gguf
*.onnx
*.engine
*.sft

# --- Generated images ---------------------------------------------
assets/generated/**
!assets/generated/.gitkeep
assets/contact-sheets/**
!assets/contact-sheets/.gitkeep
*.png
*.jpg
*.jpeg
*.webp
*.tiff
*.psd
*.exr

# Approved + canonical character assets are committed on explicit approval.
!character/reference/**
!character/expressions/**
!character/visemes/**
!character/poses/**
!assets/approved/**
!docs/**/*.png
!docs/**/*.jpg

# --- Generated video ----------------------------------------------
*.mp4
*.mov
*.mkv
*.webm
*.avi
*.gif

# --- Audio --------------------------------------------------------
*.wav
*.mp3
*.flac
*.ogg
*.m4a
*.aac

