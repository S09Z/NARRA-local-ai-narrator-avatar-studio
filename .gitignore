ComfyUI/
comfyui/
comfy/
output/
temp/
input/
custom_nodes/
user/default/
*.comfy.log
comfyui.log
extra_model_paths.yaml

# --- Python -------------------------------------------------------
.venv/
venv/
env/
ENV/
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
dist/
build/
.pytest_cache/
.ruff_cache/
.mypy_cache/
